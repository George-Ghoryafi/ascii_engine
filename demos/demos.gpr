with "../ascii_engine.gpr";

project Demos is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   
   -- Add snake.adb to the list of main programs
   for Main use ("container_test.adb", "snake.adb");

   package Compiler is
      for Switches ("ada") use ("-gnatwa", "-gnata", "-g");
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-E");
   end Binder;

end Demos;
